# Redragon M709 Ranger RGB Gaming Mouse (Holtek MCU)
# Copy this file to /etc/udev/rules.d/ and reload udev:
#   sudo cp 99-redragon-m709.rules /etc/udev/rules.d/
#   sudo udevadm control --reload-rules && sudo udevadm trigger

SUBSYSTEM=="usb", ATTR{idVendor}=="04d9", ATTR{idProduct}=="fc2a", MODE="0666", GROUP="plugdev"
SUBSYSTEM=="hidraw", ATTRS{idVendor}=="04d9", ATTRS{idProduct}=="fc2a", MODE="0666", GROUP="plugdev"
